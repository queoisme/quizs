# Chép thành .env để chạy trên máy (npm start / npm run dev tự đọc file .env nếu có).
# Trên EC2, các biến này nằm trong /etc/quiz-game.env (xem docs/deploy-aws.md).

PORT=3000

# Link công khai để tạo mã QR, ví dụ https://54-12-34-56.sslip.io
# Bỏ trống khi chơi trong mạng LAN: QR sẽ dùng IP nội bộ của máy
PUBLIC_URL=

# Mật khẩu cho trang host và soạn câu hỏi. Bỏ trống = không cần đăng nhập (chỉ nên dùng khi dev)
ADMIN_PASSWORD=
# Chuỗi ngẫu nhiên dài để ký cookie đăng nhập, tạo bằng: openssl rand -hex 32
SESSION_SECRET=

# file (mặc định) hoặc postgres
STORAGE=file
# Khi STORAGE=postgres:
# DATABASE_URL=postgres://quizadmin:MAT_KHAU@ten-db.xxxx.ap-southeast-1.rds.amazonaws.com:5432/quizgame
# DATABASE_SSL_CA=/opt/quiz-game/global-bundle.pem
